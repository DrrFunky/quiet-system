    {
        "id": "37bd8f4cd2d48d52",
        "type": "function",
        "z": "f276df6ad4972603",
        "name": "Gen: Capas de Líneas Horizontales",
        "func": "let valor = msg.payload;\n\nif (valor === \"Termino de Estado Rojo\") {\n    valor = 0;\n} else if (typeof valor === \"string\" && valor.startsWith(\"Inicio Estado Rojo\")) {\n    let maxS = global.get(\"limiteSilencio\") || 111;\n    valor = maxS;\n} else {\n    valor = Number(valor);\n}\n\nlet msgVolumen = { topic: \"Volumen del Sensor\", payload: valor };\n\nlet limiteP = global.get(\"limitePrecaucion\") || 35;\nlet limiteS = global.get(\"limiteSilencio\") || 111;\n\nlet msgPrecaucion = { topic: \"Límite Precaución\", payload: limiteP };\nlet msgRojo = { topic: \"Límite Silencio\", payload: limiteS };\n\nreturn [[msgVolumen, msgPrecaucion, msgRojo]];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 780,
        "y": 180,
        "wires": [
            [
                "6749eb40e8cb6488"
            ]
        ]
    },
    {
        "id": "bb6c5ea2f488ec6c",
        "type": "function",
        "z": "f276df6ad4972603",
        "name": "Gen: Bloques de Alerta Máxima",
        "func": "msg.topic = \"¡ALERTA ROJA!\";\n\nif (msg.payload === \"Termino de Estado Rojo\") {\n    msg.payload = 0;\n} else {\n    let limiteS = global.get(\"limiteSilencio\") || 111;\n    msg.payload = limiteS + 50;\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 450,
        "y": 180,
        "wires": [
            [
                "37bd8f4cd2d48d52"
            ]
        ]
    },
    {
        "id": "76d47a2c781dd889",
        "type": "function",
        "z": "f276df6ad4972603",
        "name": "Config: Almacenar Líneas Dinámicas",
        "func": "let partes = msg.payload.split(\",\");\n\nif (partes.length === 2) {\n    let limiteP = Number(partes[0]);\n    let limiteS = Number(partes[1]);\n    \n    global.set(\"limitePrecaucion\", limiteP);\n    global.set(\"limiteSilencio\", limiteS);\n    \n    let graficoMaximo = limiteS + 50;\n    \n    msg.ui_update = {\n        chartOptions: {\n            yAxis: {\n                min: 0,\n                max: graficoMaximo,\n                interval: Math.ceil(graficoMaximo / 6)\n            }\n        }\n    };\n    \n    msg.topic = \"¡ALERTA ROJA!\";\n    msg.payload = 0;\n    \n    return msg;\n}\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 470,
        "y": 460,
        "wires": [
            [
                "6749eb40e8cb6488"
            ]
        ]
    },
    {
        "id": "66f373bb47694b79",
        "type": "function",
        "z": "f276df6ad4972603",
        "name": "Format: Línea de Log",
        "func": "let ahora = new Date();\nlet fechaCompleta = ahora.toLocaleString(\"es-CL\"); \nlet diaActual = ahora.toLocaleDateString(\"es-CL\");\n\n// Consultamos si el día actual es distinto al último que registramos\nlet ultimoDiaGuardado = global.get(\"diaActualLog\");\nlet separador = \"\";\n\nif (ultimoDiaGuardado !== diaActual) {\n    separador = `\\n========================================\\n           ALERTAS DEL ${diaActual}\\n========================================\\n`;\n    // Guardamos el nuevo día para que no vuelva a poner el separador hasta mañana\n    global.set(\"diaActualLog\", diaActual);\n}\n\nlet mensajeRecibido = msg.payload;\nlet lineaLog = \"\";\n\nif (mensajeRecibido === \"Termino de Estado Rojo\") {\n    lineaLog = `${separador}[${fechaCompleta}] ✅ FIN: El nivel de ruido ha regresado a la normalidad.\\n`;\n} else {\n    lineaLog = `${separador}[${fechaCompleta}] 🚨 INICIO: ${mensajeRecibido}\\n`;\n}\n\nmsg.payload = lineaLog;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 620,
        "wires": [
            [
                "fa399db8ea81cd95"
            ]
        ]
    },
