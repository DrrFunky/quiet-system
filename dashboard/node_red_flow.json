    {
        "id": "0e2ee6dfb24d7307",
        "type": "function",
        "z": "f276df6ad4972603",
        "name": "function 1",
        "func": "let hoy = new Date();\n// Formatea la fecha al estilo chileno (DD/MM/YYYY) y cambia las barras por guiones para que sea un nombre de archivo válido\nlet fechaStr = hoy.toLocaleDateString(\"es-CL\").replace(/\\//g, \"-\");\n\nmsg.headers = {\n    \"Content-Type\": \"text/plain\",\n    \"Content-Disposition\": `attachment; filename=historial_ruido_${fechaStr}.txt`\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
